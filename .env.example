# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM provider — the tailor needs ONE of Gemini or DeepSeek (it has no offline
# mode). Set at least one key below. Leave LLM_PROVIDER blank: the default is
# Gemini whenever it has a key, which is the intended primary. Setting it to
# deepseek routes every pipeline through the provider with no server-side schema
# enforcement. Override per-run with `--provider gemini|deepseek` instead.
LLM_PROVIDER=

# How long a single model call may run before it is aborted (ms). Blank = 90000.
LLM_TIMEOUT_MS=

# Google Gemini.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (OpenAI-compatible API).
DEEPSEEK_API_KEY=
# Optional model override (default: deepseek-chat).
DEEPSEEK_MODEL=deepseek-chat

# Chat agent (`resume chat`) — all optional. The agent loop reuses the keys above;
# these only steer which model drives the CONVERSATION and its memory embeddings.
# AGENT_PROVIDER: gemini | deepseek. Blank → the chat PREFERS Gemini whenever a
# Gemini key is set (low latency); LLM_PROVIDER steers only the pipelines. To chat
# on DeepSeek while both keys exist, set AGENT_PROVIDER=deepseek explicitly.
# AGENT_MODEL blank → provider default (Gemini: gemini-2.5-flash, DeepSeek: deepseek-chat).
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_EMBEDDING_MODEL=gemini-embedding-001
# Semantic recall (cross-thread memory search) is OPT-IN: it adds a Gemini
# embedding round-trip before every turn. Set AGENT_RECALL=1 (needs a Gemini key)
# to enable.
AGENT_RECALL=

# Langfuse tracing — optional. Shows the prompt, the reply, tokens, latency and
# cost of every model call. `pnpm langfuse:up` starts the local stack (Docker
# required); create a project in its UI and paste the key pair below. See
# infra/langfuse/README.md. Blank LANGFUSE_ENABLED = no tracing at all, and the
# tracing SDK is never even loaded; with it on but the stack down, spans are
# dropped in the background and the run still completes.
LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Blank = http://localhost:3000. Point at https://cloud.langfuse.com to use the
# hosted service instead — nothing else changes.
LANGFUSE_BASE_URL=

# Gmail — optional. Needed only for `resume email` to actually SEND (drafting
# works without it). Use a Google APP PASSWORD, not your account password:
# Google Account → Security → 2-Step Verification (must be ON) → App passwords →
# generate one for "Mail". Paste the 16-char code (spaces are fine).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GitHub — optional. Public data scrapes without it, but a token raises the
# rate limit. Create a fine-grained/classic token with public read scope.
GITHUB_TOKEN=

# How long a scraped source stays "fresh" before the tailor re-scrapes (hours).
SCRAPE_TTL_HOURS=12

# LinkedIn — optional. To enable LIVE scraping, paste your `li_at` session
# cookie (DevTools > Application > Cookies > linkedin.com > li_at) and install
# Playwright (npm i -D playwright && npx playwright install chromium). Without
# it, the scraper falls back to parsing Linkedin_Profile.pdf in the repo root.
LINKEDIN_COOKIE=
