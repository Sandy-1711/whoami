{
  "name": "@resume/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local web studio — chat with the agent, approve its actions, edit the résumé.",
  "scripts": {
    "studio": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@resume/agent": "workspace:*",
    "@resume/cli": "workspace:*",
    "@resume/core": "workspace:*",
    "@resume/llm": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "hono": "^4.12.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
